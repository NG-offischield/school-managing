# Copy this file to `.env` and replace every placeholder.
#   cp .env.example .env
# The `.env` file is git-ignored: secrets never go into source control (spec §9).

# --- Django ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
# Hosts allowed to reach the API (never "*"). On a LAN demo, add the PC's IPv4 on the box's
# network (e.g. 192.168.1.10): mobile/tools/configure_lan.ps1 does it — see docs/reseau-local.md.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL --------------------------------------------------------------
# Used both by the `db` container (to create the database) and by Django.
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis (cache, rate limiting, WebSocket channel layer) ---------------------
REDIS_URL=redis://redis:6379/0

# --- Auth tokens ---------------------------------------------------------------
# Access tokens are short-lived; refresh tokens are long-lived but revocable.
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=30

# --- ISBREE web site and portal (ADR 0032, docs/isbree-web.md) -------------------
# Server-to-server secret shared with web/isbree-public and web/isbree-portal: proves a
# request comes from those Next.js servers so Django trusts their X-ISBREE-Client-IP
# (per-visitor rate limits). Empty = mechanism off. Generate with:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_BFF_TOKEN=
# Base URL of the Espace ISBREE portal: invitation links are {ISBREE_PORTAL_URL}/activation#code=…
ISBREE_PORTAL_URL=http://localhost:3001
PORTAL_INVITATION_LIFETIME_HOURS=48
# Version of the privacy notice accepted with each pre-enrollment (change it when the text changes).
PRE_ENROLLMENT_CONSENT_VERSION=2026-10-provisoire
# seed_isbree only (development / demo): password of the demo accounts, public contacts.
# ISBREE_DEMO_PASSWORD=
# ISBREE_CONTACT_EMAIL=
# ISBREE_CONTACT_PHONE=+237698686729
