# Espace ISBREE portal (web/isbree-portal) - copy to .env.local and adapt.
# Every variable is read on the SERVER only: none is exposed to the browser
# (no NEXT_PUBLIC_ variable). See docs/isbree-web.md.

# Public code of the school in School Managing (sent as X-School-Code).
ISBREE_SCHOOL_CODE=ISBREE
# Django API as reached FROM THIS SERVER (never from the browser).
DJANGO_INTERNAL_API_URL=http://localhost:8000/api/v1
# Public addresses. An https:// portal URL turns on Secure cookies and HSTS.
ISBREE_PUBLIC_URL=http://localhost:3000
ISBREE_PORTAL_URL=http://localhost:3001
# true = show the "demonstration" banner (fictitious accounts seeded with seed_isbree --demo).
ISBREE_DEMO_MODE=false
# Same value as WEB_BFF_TOKEN in the backend .env (proves this server to Django). Secret.
WEB_BFF_TOKEN=
# Encryption key of the session cookie: at least 32 random characters. Secret; changing
# it signs everybody out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PORTAL_SESSION_SECRET=
# Number of reverse proxies in front of Next.js that append X-Forwarded-For (production: >= 1).
ISBREE_TRUSTED_PROXY_HOPS=1
# PUBLIC DEMO ONLY (with ISBREE_DEMO_MODE=true): shared password of the read-only fictitious
# demonstration accounts, displayed on the login page. Never a real password; leave empty elsewhere.
ISBREE_DEMO_SHARED_PASSWORD=
