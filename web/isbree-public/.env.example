# ISBREE public site (web/isbree-public) — copy to .env.local and adapt.
# Every variable is read on the SERVER only: none is exposed to the browser
# (no NEXT_PUBLIC_ variable). See docs/isbree-web.md.

# Public code of the school in School Managing.
ISBREE_SCHOOL_CODE=ISBREE
# Django API as reached FROM THIS SERVER (never from the browser).
DJANGO_INTERNAL_API_URL=http://localhost:8000/api/v1
# Public addresses (sitemap, links to the portal).
ISBREE_PUBLIC_URL=http://localhost:3000
ISBREE_PORTAL_URL=http://localhost:3001
# true = show the "demonstration" banner (fictitious data seeded with seed_isbree --demo).
ISBREE_DEMO_MODE=false
# Same value as WEB_BFF_TOKEN in the backend .env: proves this server to Django
# so the visitor's address (rate limits) is trusted. Secret: never commit it.
WEB_BFF_TOKEN=
# Number of reverse proxies in front of Next.js that append X-Forwarded-For (production: >= 1).
ISBREE_TRUSTED_PROXY_HOPS=1
