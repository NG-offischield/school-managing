#: common/errors.py:55
msgid "Some fields are invalid."
msgstr "Certains champs sont invalides."

#: common/errors.py:56
msgid "The request body is malformed."
msgstr "Le corps de la requête est mal formé."

#: common/errors.py:57
msgid "Resource not found."
msgstr "Ressource introuvable."

#: common/errors.py:58
msgid "This method is not allowed on this resource."
msgstr "Cette méthode n'est pas autorisée sur cette ressource."

#: common/errors.py:59
msgid "The requested response format is not available."
msgstr "Le format de réponse demandé n'est pas disponible."

#: common/errors.py:60
msgid "Unsupported content type."
msgstr "Type de contenu non pris en charge."

#: common/errors.py:61
msgid "Too many requests. Please try again later."
msgstr "Trop de requêtes. Veuillez réessayer plus tard."

#: common/errors.py:62
msgid "An unexpected error occurred."
msgstr "Une erreur inattendue s'est produite."

#: common/errors.py:63
msgid "This operation breaks a business rule."
msgstr "Cette opération enfreint une règle métier."

#: common/errors.py:64
msgid "This operation conflicts with existing data."
msgstr "Cette opération est en conflit avec des données existantes."

#: common/errors.py:65
msgid "Authentication is required."
msgstr "Une authentification est requise."

#: common/errors.py:66
msgid "Authentication failed."
msgstr "Échec de l'authentification."

#: common/errors.py:67
msgid "Invalid credentials."
msgstr "Identifiants incorrects."

#: common/errors.py:68
msgid "Invalid or expired access token."
msgstr "Jeton d'accès invalide ou expiré."

#: common/errors.py:69
msgid "Invalid or expired refresh token."
msgstr "Jeton de renouvellement invalide ou expiré."

#: common/errors.py:70
msgid "You do not have permission to perform this action."
msgstr "Vous n'avez pas la permission d'effectuer cette action."

#: common/errors.py:71
msgid "No active school membership for this request."
msgstr "Aucune adhésion active à un établissement pour cette requête."

#: common/errors.py
msgid "This activation code is invalid or expired."
msgstr "Ce code d'activation est invalide ou expiré."
