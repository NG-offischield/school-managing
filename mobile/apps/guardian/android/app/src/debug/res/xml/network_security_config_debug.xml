<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build only (src/debug): the development backend over HTTP on the local network.
     The PC's LAN address changes with the box/router, and Android cannot list an IP range
     here, so clear text is allowed in DEBUG for the app; school_core AppConfig narrows it to
     private addresses (RFC 1918, loopback, 10.0.2.2). Release builds never ship this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
